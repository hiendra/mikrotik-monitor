# Salin berkas ini menjadi .env, lalu isi token dari Cloudflare.
# Ambil token di: Zero Trust -> Networks -> Tunnels -> (tunnel Anda) -> Docker
#
# Token ini adalah kunci masuk server: jangan di-commit, jangan ditempel ke
# chat, jangan dikirim lewat pesan. Berkas .env sudah masuk .gitignore.
TUNNEL_TOKEN=ganti-dengan-token-dari-cloudflare
