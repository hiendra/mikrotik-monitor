        {
          "refId": "I",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "meshtastic_node_last_heard_seconds",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "J",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "meshtastic_environment_temperature_celsius",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "K",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "meshtastic_environment_humidity_percent",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "node_id",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "Time 1": true,
              "__name__ 1": true,
              "job 1": true,
              "instance 1": true,
              "Time 2": true,
              "__name__ 2": true,
              "job 2": true,
              "instance 2": true,
              "Time 3": true,
              "__name__ 3": true,
              "job 3": true,
              "instance 3": true,
              "Time 4": true,
              "__name__ 4": true,
              "job 4": true,
              "instance 4": true,
              "Time 5": true,
              "__name__ 5": true,
              "job 5": true,
              "instance 5": true,
              "Time 6": true,
              "__name__ 6": true,
              "job 6": true,
              "instance 6": true,
              "Time 7": true,
              "__name__ 7": true,
              "job 7": true,
              "instance 7": true,
              "Time 8": true,
              "__name__ 8": true,
              "job 8": true,
              "instance 8": true,
              "Time 9": true,
              "__name__ 9": true,
              "job 9": true,
              "instance 9": true,
              "Time 10": true,
              "__name__ 10": true,
              "job 10": true,
              "instance 10": true,
              "Time 11": true,
              "__name__ 11": true,
              "job 11": true,
              "instance 11": true,
              "Value": true
            },
          "renameByName": {
            "node_id": "ID",
            "via": "Via",
            "long_name": "Nama",
              "short_name": "Singkat",
              "hw_model": "Perangkat",
              "role": "Role",
              "Value 1": "Baterai (%)",
              "Value 2": "Tegangan (V)",
              "Value 3": "Kanal (%)",
              "Value 4": "Air TX (%)",
              "Value 5": "SNR (dB)",
              "Value 6": "Hop",
              "Value 7": "Online",
              "Value 8": "Terakhir (detik)",
              "Value 9": "Suhu (C)",
              "Value 10": "Kelembapan (%)"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Baterai (%)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 20
                    },
                    {
                      "color": "green",
                      "value": 50
                    }
                  ]
                }
              }
            ]
          },
        {
          "matcher": {
            "id": "byName",
            "options": "Via"
          },
          "properties": [
            {
              "id": "mappings",
              "value": [
                {
                  "type": "value",
                  "options": {
                    "lora": {
                      "text": "LoRa",
                      "color": "green",
                      "index": 0
                    },
                    "mqtt": {
                      "text": "MQTT",
                      "color": "blue",
                      "index": 1
                    },
                    "diri": {
                      "text": "GATEWAY",
                      "color": "text",
                      "index": 2
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "matcher": {
            "id": "byName",
            "options": "Online"
          },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "OFFLINE",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "ONLINE",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Terakhir (detik)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "SNR (dB)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dB"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
