[Unit]
Description=Reset NodeDB gateway Meshtastic (sekali jalan)
Documentation=file:/opt/meshtastic-monitor/README.md
After=network-online.target
Wants=network-online.target
# Catatan: aman berjalan bersamaan dengan exporter (koneksi TCP terpisah).

[Service]
Type=oneshot
# Sesuaikan user dan path sesuai instalasi Anda.
User=meshtastic
WorkingDirectory=/opt/meshtastic-monitor
Environment=MESH_HOST=192.168.20.31
Environment=MESH_PORT=4403
Environment=NTFY_SERVER=https://ntfy.adminforge.de
Environment=NTFY_TOPIK=mesh-6h4v8p2rxq
Environment=NTFY_LOKAL=http://192.168.200.253:7200
# --ya                 benar-benar jalankan reset (bawaan hanya periksa)
# --hanya-jika-penuh   lewati bila isi NodeDB masih di bawah ambang
# --jeda-min-jam 36    pengaman agar tidak dobel setelah restart/persistent
# --jendela-notif      lama notifier menahan alarm "node hilang" pasca reset
ExecStart=/opt/meshtastic-monitor/venv/bin/python /opt/meshtastic-monitor/reset-node.py --ya --hanya-jika-penuh 190 --jeda-min-jam 36 --jendela-notif 1800
# Reset NodeDB memicu gateway memuat ulang daftar; beri waktu di luar jam sibuk.
TimeoutStartSec=180
