# Normalisasi line-ending agar isi file konsisten di semua komputer
* text=auto

# Source Arduino & header -> CRLF (khas Windows, cocok dengan Arduino IDE)
*.h      text eol=crlf
*.ino    text eol=crlf
*.ps1    text eol=crlf
*.bat    text eol=crlf

# Dokumen & halaman -> LF
*.md     text eol=lf
*.html   text eol=lf
# Skrip Node (validasi-hosting.mjs) -> LF agar sama di semua sistem
*.mjs    text eol=lf

# Berkas yang dijalankan di sisi Linux (ZimaOS) -> wajib LF
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
Caddyfile   text eol=lf
.env.example text eol=lf

# File biner jangan diubah
*.png    binary
*.jpg    binary
*.zip    binary
*.bin    binary
*.elf    binary
