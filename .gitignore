# ==================== MESHTASTIC MONITOR (artefak runtime) ====================
# Log, status, dan penanda yang lahir saat layanan berjalan. Semuanya khusus
# mesin ini, jadi tidak boleh ikut ter-commit. Berkas sumber (skrip, unit,
# dashboard, alert) TIDAK diabaikan.
meshtastic-monitor/__pycache__/
# Pycache subfolder (mis. lacak-kerja/) juga harus diabaikan
**/__pycache__/
meshtastic-monitor/*.log
meshtastic-monitor/notif-meshtastic-state.json
meshtastic-monitor/reset-terakhir.json
meshtastic-monitor/catat-node.csv
meshtastic-monitor/*.tgz
# Basis data pelacakan layar: lahir saat lacak_node.py berjalan (runtime)
meshtastic-monitor/lacak-kerja/lacak.sqlite3

# ==================== BERKAS KERJA SEMENTARA ====================
# Skrip/keluaran sekali pakai di akar repo (pembaca keluaran zima-shell,
# potongan konfigurasi yang diuji, dsb). Tidak pernah jadi sumber; jangan
# sampai ikut ter-commit.
.tmp-*

# ==================== AREA KERJA UJI ====================
# Bukti mentah dari sesi uji/audit (dump host, log perintah, salinan aset live,
# berkas diff besar). Bukan berkas sumber; jangan pernah ikut ter-commit.
.uji-tmp/

# ==================== ARTEFAK UJI & PENERAPAN ====================
# Keduanya lahir saat MENJALANKAN alat, bukan berkas sumber: salinan HTML untuk
dilihat di peramban (uji-halaman-meshtastic.py) dan log penerapan ke ZimaOS
(pasang-ke-zima.sh). Salinan sementara uji validasi sudah diabaikan di atas.
.tmp-uji-halaman/
.keluaran-pasang.log

# ==================== FIRMWARE MESHTASTIC (checkout terpisah) ====================
# Salinan repo firmware (fork richardvsw/firmware) untuk membangun varian
# handheld-s3. Di dalamnya ada repo git SENDIRI, jadi git hanya akan melihatnya
# sebagai satu direktori tak terawat: '?? firmware/'. Jangan pernah pakai
# 'git add -A' di repo ini; tambahkan berkas firmware satu per satu bila perlu.
